{
  "name": "onekey-tab",
  "description": "manifest.json description",
  "private": true,
  "version": "0.13.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "release": "pnpm version --message \"chore(release): v%s\"",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@wxt-dev/auto-icons": "^1.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^5.0.0",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
